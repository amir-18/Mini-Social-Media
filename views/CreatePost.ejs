<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New Post</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-zinc-950 text-white flex items-center justify-center h-screen">

    <div class="bg-zinc-900 p-8 rounded-2xl w-full max-w-md shadow-lg border border-zinc-800">
        <h1 class="text-2xl font-bold mb-6 text-indigo-400">Create a Post</h1>
        
        <form action="/post/create" method="POST" class="flex flex-col gap-4">
            
            <div>
                <label class="text-xs text-zinc-500 uppercase font-bold">Post Title</label>
                <input 
                    type="text" 
                    name="Postname" 
                    placeholder="Give your post a name..." 
                    required
                    class="w-full mt-1 bg-zinc-800 border border-zinc-700 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-zinc-200"
                >
            </div>

            <div>
                <label class="text-xs text-zinc-500 uppercase font-bold">Content</label>
                <textarea 
                    name="content" 
                    placeholder="What are you thinking about?" 
                    required
                    class="w-full mt-1 h-32 bg-zinc-800 border border-zinc-700 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-zinc-200 resize-none"
                ></textarea>
            </div>

            <button 
                type="submit" 
                class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 rounded-lg mt-2 transition duration-200"
            >
                Publish Post
            </button>
            
            <a href="/home" class="text-center text-zinc-500 hover:text-zinc-300 text-sm">Go back</a>
        </form>
    </div>

</body>
</html>