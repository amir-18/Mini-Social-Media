<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <title>Register | Social Platform</title>
    <style>
        body { font-family: 'Inter', sans-serif; }
        .bg-glow {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(99, 102, 241, 0.12) 0%, rgba(0, 0, 0, 0) 70%);
            z-index: -1;
        }
    </style>
</head>
<body class="bg-[#09090b] text-zinc-100 flex items-center justify-center min-h-screen p-6 relative overflow-hidden">

    <div class="bg-glow"></div>

    <div class="w-full max-w-[480px]">
        <div class="text-center mb-10">
            <div class="inline-flex w-14 h-14 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-2xl rotate-12 items-center justify-center mb-6 shadow-2xl shadow-indigo-500/20">
                <svg class="w-8 h-8 text-white -rotate-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
                </svg>
            </div>
            <h2 class="text-3xl font-extrabold tracking-tight text-white mb-2">Create an account</h2>
            <p class="text-zinc-500 font-medium">Join our community of creators today.</p>
        </div>

        <div class="bg-zinc-900/50 backdrop-blur-xl p-8 rounded-[2.5rem] border border-zinc-800/50 shadow-2xl">
            <form action="/SignUp" method="POST" class="space-y-5">
                
                <div class="grid grid-cols-3 gap-4">
                    <div class="col-span-2">
                        <label class="block text-xs uppercase tracking-[0.15em] font-bold text-zinc-500 mb-2 ml-1">Username</label>
                        <input type="text" name="username" placeholder="johndoe" 
                            class="w-full px-5 py-3.5 rounded-2xl bg-zinc-950 border border-zinc-800 focus:border-indigo-500/50 focus:ring-4 focus:ring-indigo-500/10 outline-none transition-all placeholder:text-zinc-700" required>
                    </div>
                    <div class="col-span-1">
                        <label class="block text-xs uppercase tracking-[0.15em] font-bold text-zinc-500 mb-2 ml-1">Age</label>
                        <input type="number" name="age" placeholder="21" 
                            class="w-full px-5 py-3.5 rounded-2xl bg-zinc-950 border border-zinc-800 focus:border-indigo-500/50 focus:ring-4 focus:ring-indigo-500/10 outline-none transition-all placeholder:text-zinc-700">
                    </div>
                </div>

                <div>
                    <label class="block text-xs uppercase tracking-[0.15em] font-bold text-zinc-500 mb-2 ml-1">Email Address</label>
                    <input type="email" name="email" placeholder="name@example.com" 
                        class="w-full px-5 py-3.5 rounded-2xl bg-zinc-950 border border-zinc-800 focus:border-indigo-500/50 focus:ring-4 focus:ring-indigo-500/10 outline-none transition-all placeholder:text-zinc-700" required>
                </div>

                <div>
                    <label class="block text-xs uppercase tracking-[0.15em] font-bold text-zinc-500 mb-2 ml-1">Password</label>
                    <input type="password" name="password" placeholder="••••••••" 
                        class="w-full px-5 py-3.5 rounded-2xl bg-zinc-950 border border-zinc-800 focus:border-indigo-500/50 focus:ring-4 focus:ring-indigo-500/10 outline-none transition-all placeholder:text-zinc-700" required>
                    <p class="mt-2 ml-1 text-[10px] text-zinc-600 font-medium tracking-wide">Must be at least 8 characters long.</p>
                </div>

                <div class="pt-2">
                    <button type="submit" 
                        class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-4 rounded-2xl transition-all duration-300 shadow-xl shadow-indigo-600/20 active:scale-[0.98]">
                        Create Account
                    </button>
                </div>
            </form>

            <div class="mt-8 pt-6 border-t border-zinc-800/50 text-center">
                <p class="text-zinc-500 font-medium text-sm">
                    Already a member? <a href="/login" class="text-indigo-400 font-bold hover:text-indigo-300 transition-colors underline underline-offset-4 decoration-2 decoration-indigo-500/20">Log in here</a>
                </p>
            </div>
        </div>

        <div class="mt-8 flex justify-center gap-6 text-[11px] font-bold uppercase tracking-widest text-zinc-600">
            <a href="#" class="hover:text-zinc-400 transition-colors">Privacy Policy</a>
            <a href="#" class="hover:text-zinc-400 transition-colors">Terms of Service</a>
        </div>
    </div>

</body>
</html>