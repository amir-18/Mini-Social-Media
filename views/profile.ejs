<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <title><%= user.username %> | Profile</title>
    <style>
        body { font-family: 'Inter', sans-serif; }
        .glass { background: rgba(24, 24, 27, 0.8); backdrop-filter: blur(12px); }
    </style>
</head>
<body class="bg-[#09090b] text-zinc-100 min-h-screen pb-12">

    <nav class="glass sticky top-0 z-50 border-b border-zinc-800/50 px-6 py-4">
        <div class="max-w-4xl mx-auto flex items-center justify-between">
            <a href="/home" class="flex items-center gap-2 group">
                <div class="p-2 rounded-lg bg-zinc-900 border border-zinc-800 group-hover:border-indigo-500 transition-all">
                    <svg class="w-5 h-5 text-zinc-400 group-hover:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                </div>
                <span class="font-bold text-sm tracking-tight">Feed</span>
            </a>
            <h1 class="text-xl font-bold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-white to-zinc-400">Profile</h1>
            <a href="/logout" class="text-xs font-bold uppercase tracking-widest text-zinc-500 hover:text-rose-400 transition-colors">Logout</a>
        </div>
    </nav>

    <div class="max-w-4xl mx-auto px-6 pt-12">
        
        <header class="bg-zinc-900/40 border border-zinc-800/60 rounded-[2.5rem] p-8 md:p-12 mb-12 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-64 h-64 bg-indigo-600/10 blur-[80px] -z-10"></div>
            
            <div class="flex flex-col md:flex-row items-center gap-8">
                <div class="w-32 h-32 rounded-[2.5rem] bg-gradient-to-br from-indigo-500 to-purple-600 p-[2px] shadow-2xl shadow-indigo-500/20">
                    <div class="w-full h-full bg-zinc-950 rounded-[2.4rem] flex items-center justify-center">
                        <span class="text-5xl font-black text-transparent bg-clip-text bg-gradient-to-br from-indigo-400 to-purple-500">
                            <%= user.username.charAt(0).toUpperCase() %>
                        </span>
                    </div>
                </div>

                <div class="flex-1 text-center md:text-left">
                    <div class="flex flex-col md:flex-row md:items-center gap-4 mb-4">
                        <h2 class="text-3xl font-black tracking-tight text-white"><%= user.username %></h2>
                        <span class="px-4 py-1 rounded-full bg-zinc-800 border border-zinc-700 text-xs font-bold text-zinc-400 w-fit mx-auto md:mx-0">
                            Age: <%= user.age %>
                        </span>
                    </div>
                    <p class="text-zinc-500 font-medium mb-6"><%= user.email %></p>
                    
                    <div class="flex justify-center md:justify-start gap-8 border-t border-zinc-800/50 pt-6">
                        <div>
                            <p class="text-xl font-bold text-white"><%= posts.length %></p>
                            <p class="text-[10px] uppercase tracking-[0.2em] font-black text-zinc-600">Posts</p>
                        </div>
                        <div>
                            <% let totalLikes = 0; posts.forEach(p => { if(p.likes) totalLikes += p.likes.length }); %>
                            <p class="text-xl font-bold text-white"><%= totalLikes %></p>
                            <p class="text-[10px] uppercase tracking-[0.2em] font-black text-zinc-600">Total Likes</p>
                        </div>
                    </div>
                </div>

                <div class="flex flex-col gap-3 w-full md:w-auto">
                    <a href="/createpost" class="bg-white text-black text-center px-8 py-3 rounded-2xl font-bold hover:bg-zinc-200 transition-all active:scale-95">
                        New Post
                    </a>
                    
                </div>
            </div>
        </header>

        <section>
            <div class="flex items-center gap-4 mb-8">
                <h3 class="text-xl font-bold tracking-tight">Your Creations</h3>
                <div class="h-[1px] flex-1 bg-zinc-800"></div>
            </div>

            <div class="grid grid-cols-1 gap-6">
                <% if (posts.length > 0) { %>
                    <% posts.forEach(post => { %>
                        <article class="group bg-zinc-900/30 border border-zinc-800/60 rounded-3xl p-6 hover:border-indigo-500/30 transition-all duration-300">
                            <div class="flex justify-between items-start mb-4">
                                <p class="text-zinc-300 leading-relaxed"><%= post.content %></p>
                                <div class="flex items-center gap-2 text-rose-500 bg-rose-500/10 px-3 py-1 rounded-full text-xs font-bold">
                                    ❤️ <%= post.likes ? post.likes.length : 0 %>
                                </div>
                            </div>
                            
                            <div class="flex items-center justify-between pt-4 border-t border-zinc-800/50">
                                <span class="text-[10px] font-black uppercase tracking-widest text-zinc-600">
                                    Posted in General
                                </span>
                                <div class="flex gap-4">
                                    <a href="/edit/<%= post._id %>" class="text-xs font-bold text-zinc-500 hover:text-indigo-400 transition-colors">Edit</a>
                                    <a href="/deletepost/<%= post._id %>" class="text-xs font-bold text-zinc-500 hover:text-rose-500 transition-colors">Delete</a>
                                </div>
                            </div>
                        </article>
                    <% }) %>
                <% } else { %>
                    <div class="text-center py-20 bg-zinc-900/10 rounded-3xl border border-dashed border-zinc-800">
                        <div class="w-16 h-16 bg-zinc-900 rounded-full flex items-center justify-center mx-auto mb-4">
                            <svg class="w-8 h-8 text-zinc-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                        </div>
                        <p class="text-zinc-500 font-medium tracking-tight">You haven't shared anything yet.</p>
                        <a href="/createpost" class="text-indigo-400 font-bold text-sm hover:underline mt-2 inline-block">Create your first post</a>
                    </div>
                <% } %>
            </div>
        </section>
    </div>

</body>
</html>