<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <title>Home | Social Platform</title>
    <style>
        body { font-family: 'Inter', sans-serif; }
        .glass { background: rgba(24, 24, 27, 0.8); backdrop-filter: blur(12px); }
    </style>
</head>
<body class="bg-[#09090b] text-zinc-100 min-h-screen selection:bg-indigo-500/30">

    <nav class="glass sticky top-0 z-50 border-b border-zinc-800/50 px-6 py-4">
        <div class="max-w-6xl mx-auto flex items-center justify-between">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-lg rotate-12"></div>
                <h1 class="text-xl font-bold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-white to-zinc-400">
                    Social.
                </h1>
            </div>

            <div class="flex items-center gap-6">
                <% if (user) { %>
                    <div class="hidden md:flex items-center gap-3 pr-6 border-r border-zinc-800">
                        <div class="text-right">
                            <p class="text-sm font-medium leading-none"><%= user.username %></p>
                            <p class="text-xs text-zinc-500 mt-1"><%= user.email %></p>
                        </div>
                        <a href="/profile" class="w-10 h-10 rounded-full bg-zinc-800 border border-zinc-700 flex items-center justify-center text-indigo-400 font-bold hover:border-indigo-500 transition-all">
                            <%= user.username.charAt(0).toUpperCase() %>
                        </a>
                    </div>
                    <a href="/logout" class="text-sm font-medium text-zinc-400 hover:text-white transition-colors">Logout</a>
                <% } else { %>
                    <a href="/login" class="bg-white text-black px-5 py-2 rounded-full text-sm font-bold hover:bg-zinc-200 transition-all">
                        Get Started
                    </a>
                <% } %>
            </div>
        </div>
    </nav>

    <div class="max-w-4xl mx-auto grid grid-cols-1 lg:grid-cols-[240px_1fr] gap-10 p-6">
        
        <aside class="hidden lg:block space-y-6">
            <div class="space-y-1">
                <a href="/home" class="flex items-center gap-3 px-4 py-3 bg-zinc-900 rounded-xl text-indigo-400 font-medium">
                    <span>🏠</span> Home
                </a>
                <% if (user) { %>
                <a href="/profile" class="flex items-center gap-3 px-4 py-3 text-zinc-400 hover:bg-zinc-900 rounded-xl transition-all">
                    <span>👤</span> My Profile
                </a>
                <% } %>
            </div>
            <% if (user) { %>
                <a href="/createpost" class="block w-full text-center bg-indigo-600 hover:bg-indigo-500 shadow-lg shadow-indigo-500/20 py-3 rounded-xl font-bold transition-all">
                    Create Post
                </a>
            <% } %>
        </aside>

        <main>
            <div class="mb-8">
                <h2 class="text-2xl font-bold tracking-tight text-white">Recent Activity</h2>
            </div>

            <div class="space-y-6">
                <% if (posts.length > 0) { %>
                    <% posts.forEach(post => { %>
                        <article class="group bg-zinc-900/40 border border-zinc-800/60 rounded-3xl p-6 hover:bg-zinc-900 transition-all duration-300">
                            
                            <div class="flex items-center justify-between mb-5">
                                <div class="flex items-center gap-3">
                                    <div class="w-11 h-11 bg-gradient-to-tr from-zinc-800 to-zinc-700 rounded-2xl flex items-center justify-center font-bold text-zinc-400 border border-zinc-700/50">
                                        <%= post.UserId ? post.UserId.username.charAt(0).toUpperCase() : "A" %>
                                    </div>
                                    <div>
                                        <span class="font-bold text-zinc-100 group-hover:text-indigo-400 transition-colors">
                                            @<%= post.UserId ? post.UserId.username : "anonymous" %>
                                        </span>
                                        <p class="text-[11px] uppercase tracking-widest text-zinc-500 font-semibold">Post Author</p>
                                    </div>
                                </div>
                            </div>

                            <div class="text-[16px] leading-relaxed text-zinc-300 mb-6 px-1">
                                <%= post.content %>
                            </div>

                            <% const liked = user && post.likes && post.likes.indexOf(user._id.toString()) !== -1; %>
                            <div class="flex items-center gap-6 pt-4 border-t border-zinc-800/50">
                                <a href="/Like/<%= post._id %>" 
                                   class="flex items-center gap-2 group/btn transition-all <%= liked ? 'text-rose-500' : 'text-zinc-500 hover:text-rose-500' %>">
                                    <div class="p-2 rounded-full <%= liked ? 'bg-rose-500/10' : 'group-hover/btn:bg-rose-500/10' %> transition-all">
                                        <svg class="w-5 h-5" fill="<%= liked ? 'currentColor' : 'none' %>" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                                    </div>
                                    <span class="text-sm font-bold"><%= post.likes ? post.likes.length : 0 %></span>
                                </a>

                                <div class="flex items-center gap-2 text-zinc-500 cursor-default">
                                    <div class="p-2 rounded-full">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                                    </div>
                                    <span class="text-sm font-bold"><%= post.comments ? post.comments.length : 0 %></span>
                                </div>
                            </div>

                            <div class="mt-6 space-y-3">
                                <% if (post.comments && post.comments.length > 0) { %>
                                    <% post.comments.forEach(comment => { %>
                                        <div class="flex gap-3 text-sm">
                                            <span class="font-bold text-indigo-400">@<%= comment.user.username %></span>
                                            <span class="text-zinc-400"><%= comment.text %></span>
                                        </div>
                                    <% }) %>
                                <% } %>

                                <% if (user) { %>
                                    <form action="/comment/<%= post._id %>" method="POST" class="relative mt-4">
                                        <input type="text" name="comment" placeholder="Write a comment..." 
                                               class="w-full bg-zinc-800/50 border border-zinc-700/50 rounded-2xl px-5 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/50 transition-all">
                                        <button type="submit" class="absolute right-3 top-2 text-indigo-500 font-bold text-xs p-2 hover:text-indigo-400 transition-colors">Post</button>
                                    </form>
                                <% } %>
                            </div>
                        </article>
                    <% }) %>
                <% } else { %>
                    <div class="text-center py-20 bg-zinc-900/20 rounded-3xl border border-dashed border-zinc-800">
                        <p class="text-zinc-500">Silence is golden. Start the noise by posting.</p>
                    </div>
                <% } %>
            </div>
        </main>
    </div>

</body>
</html>